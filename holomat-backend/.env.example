# HoloMat Backend Environment Variables
# This file is loaded automatically by python-dotenv in main.py

# Groq API (for Jarvis chat responses)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API (for image generation via /api/generate-image)
GEMINI_API_KEY=your_gemini_api_key_here

# Pollinations.ai fallback (free token from enter.pollinations.ai)
POLLINATIONS_TOKEN=your_pollinations_token_here

# Tripo3D API (for 3D model generation)
TRIPO_API_KEY=your_tripo_api_key_here

# Optional: Override default Groq model
# GROQ_MODEL=llama-3.1-8b-instant
